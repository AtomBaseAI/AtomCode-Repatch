generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id       String    @id @default(cuid())
  name     String?
  email    String    @unique
  image    String?
  password String
  accounts Account[]
}

model SuperAdmin {
  id       String    @id @default(cuid())
  name     String?
  email    String    @unique
  image    String?
  password String
  accounts Account[]
}

model Staff {
  id          String        @id @default(cuid())
  name        String?
  email       String        @unique
  phone       String?
  image       String?
  department  String?
  staffnumber String?
  password    String
  accounts    Account[]
  StaffCourse StaffCourse[]
}

model User {
  id                     String                   @id @default(cuid())
  name                   String?
  department             String?
  section                String?
  batch                  String?
  rollnumber             String?
  github                 String?
  linkedin               String?
  email                  String                   @unique
  phone                  String?
  emailVerified          DateTime?
  image                  String?
  password               String
  isActive               Boolean                  @default(true)
  isTwoFactorEnabled     Boolean
  userCourses            UserCourse[]
  userModuleData         UserModuleData[]
  userMCQData            UserMCQData[]
  userQuestionData       UserQuestionData[]
  accounts               Account[]
  userAssessmentMCQData  userAssessmentMCQData[]
  userAssessmentCodeData userAssessmentCodeData[]
  UserAssessmentData     UserAssessmentData[]
}

model Course {
  id                 String               @id @default(uuid())
  title              String
  startdate          DateTime
  enddate            DateTime
  language           String
  userCourses        UserCourse[]
  staffCourses       StaffCourse[]
  assessments        Assessments[]
  modules            Module[]
  userModuleData     UserModuleData[]
  feedbacks          Feedbacks[]
  UserAssessmentData UserAssessmentData[]
}

model Feedbacks {
  id       String   @id @default(uuid())
  courseId String
  title    String
  link     String
  date     DateTime
  Course   Course?  @relation(fields: [courseId], references: [id])
}

model Module {
  id               String             @id @default(uuid())
  title            String
  courseId         String
  course           Course             @relation(fields: [courseId], references: [id])
  moduledate       DateTime
  modulestatus     String
  language         String
  maxscore         Int
  concepturl       String?
  mcqQuestions     MCQQuestion[]
  questions        Question[]
  userModuleData   UserModuleData[]
  userMCQData      UserMCQData[]
  userQuestionData UserQuestionData[]
  reference        ModuleReferences[]
}

model ModuleReferences {
  id       String  @id @default(uuid())
  title    String
  link     String
  type     String
  Module   Module? @relation(fields: [moduleId], references: [id])
  moduleId String?
}

model UserModuleData {
  id                 String  @id @default(uuid())
  userId             String
  courseId           String
  moduleId           String
  mcqtime            Int?
  mcqstatus          String?
  usermcqscore       Int?
  totalmcqscore      Int?
  questiontime       Int?
  questionstatus     String?
  userquestionscore  Int?
  totalquestionscore Int?
  errors             Int?
  compiles           Int?
  modulemaxscore     Int?
  modulestatus       String
  user               User    @relation(fields: [userId], references: [id])
  course             Course  @relation(fields: [courseId], references: [id])
  module             Module  @relation(fields: [moduleId], references: [id])
}

model Question {
  id                     String                   @id @default(uuid())
  title                  String
  description            String
  moduleId               String?
  module                 Module?                  @relation(fields: [moduleId], references: [id])
  sampleinput1           String
  sampleinput2           String
  sampleoutput1          String
  sampleoutput2          String
  input1                 String
  input2                 String
  input3                 String
  output1                String
  output2                String
  output3                String
  sourcecode             String?
  referenceimg           String?
  maxscore               Int
  difficulty             String
  lang                   String
  topic                  String?
  subtopic               String?
  inputconstrains        String?
  blacklist              String?
  whitelist              String?
  userQuestionData       UserQuestionData[]
  userAssessmentCodeData userAssessmentCodeData[]
  Assessments            Assessments?             @relation(fields: [assessmentsId], references: [id])
  assessmentsId          String?
}

model UserQuestionData {
  id              String   @id @default(uuid())
  userId          String
  questionId      String   @default(cuid())
  moduleId        String
  score           Int
  compiles        Int
  errors          Int
  submissiontype  String
  tabswitches     Int
  status          String
  usercode        String?
  duration        String?
  testcase1status String?
  testcase2status String?
  testcase3status String?
  user            User     @relation(fields: [userId], references: [id])
  question        Question @relation(fields: [questionId], references: [id])
  module          Module   @relation(fields: [moduleId], references: [id])

  @@unique([userId, questionId])
}

model MCQQuestion {
  id            String       @id @default(uuid())
  title         String
  description   String
  topic         String?
  subtopic      String?
  Option1       String
  Option2       String
  Option3       String
  Option4       String
  CorrectOption Int
  moduleId      String?
  referenceimg  String?
  codesnippet   String?
  iscodesnippet Boolean
  module        Module?       @relation(fields: [moduleId], references: [id])
  Assessments   Assessments? @relation(fields: [assessmentsId], references: [id])
  assessmentsId String?
}

model UserMCQData {
  id             String  @id @default(uuid())
  userId         String
  moduleId       String
  score          Int
  errors         Int
  submissiontype String
  tabswitches    Int
  status         String
  duration       String?
  user           User    @relation(fields: [userId], references: [id])
  module         Module  @relation(fields: [moduleId], references: [id])
}

model StaffCourse {
  id       String  @id @default(uuid())
  staffId  String
  courseId String
  active   Boolean
  staff    Staff   @relation(fields: [staffId], references: [id])
  course   Course  @relation(fields: [courseId], references: [id])
}

model UserCourse {
  id                   String  @id @default(uuid())
  userId               String
  courseId             String
  active               Boolean
  completionPercentage Float
  user                 User    @relation(fields: [userId], references: [id])
  course               Course  @relation(fields: [courseId], references: [id])
}

model Account {
  id                String     @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?    @db.Text
  access_token      String?    @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?    @db.Text
  session_state     String?
  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  Admin             Admin      @relation(fields: [adminId], references: [id])
  Staff             Staff      @relation(fields: [staffId], references: [id])
  SuperAdmin        SuperAdmin @relation(fields: [superadminId], references: [id])
  adminId           String
  staffId           String
  superadminId      String

  @@unique([provider, providerAccountId])
}

// New models

model Assessments {
  id          String   @id @default(uuid())
  title       String
  date        DateTime
  accesskey   Int
  language    String
  courseId    String
  maxtime     String
  active      Boolean
  maxscore    Int
  tabswitches Int
  course      Course   @relation(fields: [courseId], references: [id])
  mcqQuestions           MCQQuestion[]
  questions              Question[]
  UserAssessmentData     UserAssessmentData[]
  userAssessmentMCQData  userAssessmentMCQData[]
  userAssessmentCodeData userAssessmentCodeData[]
}

model userAssessmentMCQData {
  id             String      @id @default(uuid())
  userId         String
  assessmentId   String
  score          Int
  errors         Int
  submissiontype String
  status         String
  duration       String?
  user           User        @relation(fields: [userId], references: [id])
  assessments    Assessments @relation(fields: [assessmentId], references: [id])
}

model userAssessmentCodeData {
  id              String      @id @default(uuid())
  userId          String
  questionId      String      @default(cuid())
  assessmentId    String
  score           Int
  compiles        Int
  errors          Int
  submissiontype  String
  status          String
  usercode        String?
  duration        String?
  testcase1status String?
  testcase2status String?
  testcase3status String?
  user            User        @relation(fields: [userId], references: [id])
  question        Question    @relation(fields: [questionId], references: [id])
  assessments     Assessments @relation(fields: [assessmentId], references: [id])
  @@unique([userId, questionId])
}

model UserAssessmentData {
  id                      String      @id @default(uuid())
  userId                  String
  courseId                String
  assessmentId            String
  mcqtime                 Int?
  mcqstatus               String?
  usermcqscore            Int?
  totalmcqscore           Int?
  questiontime            Int?
  questionstatus          String?
  userquestionscore       Int?
  totalquestionscore      Int?
  errors                  Int?
  compiles                Int?
  assessmentmaxscore      Int?
  assessmentstarttime     String
  userassessmentstarttime String
  usertabswitches         Int
  maxtabswitches          Int
  submissiontype          String?
  status                  String
  maxtime                 String
  userduration            String?
  user                    User        @relation(fields: [userId], references: [id])
  course                  Course      @relation(fields: [courseId], references: [id])
  assessments             Assessments @relation(fields: [assessmentId], references: [id])
}
